# Vorlage für deploy/.env auf dem Server, Rechte 600; docker-compose.prod.yml liest die Werte
# Passwörter nur hexadezimal, etwa aus openssl rand -hex 32: Sie stehen in Datenbank-URLs

# Superuser von PostgreSQL; gilt nur beim Einrichten eines leeren Volumes
POSTGRES_PASSWORD=
# Die Passwörter der beiden Rollen setzt deploy.sh bei jedem Deploy; ein neuer Wert wechselt sie
# Rolle der API (cevi_os_api)
API_DB_PASSWORD=
# Besitzer der Tabellen (cevi_os_besitzer), nur für die Migration
MIGRATION_DB_PASSWORD=
# Älteste App-Version, die die API annimmt (x.y.z); ältere bekommen 426
APP_MIN_VERSION=
# Schlüssel von better-auth, mindestens 32 Zeichen, etwa aus openssl rand -base64 32; ein Wechsel macht die zweiten Faktoren unlesbar (docs/betrieb.md)
BETTER_AUTH_SECRET=
# Öffentliche Adresse der API mit https, etwa https://api.cevios.ch
BETTER_AUTH_URL=

# Verschlüsselte Backups mit restic (backup.sh); Einrichtung: docs/betrieb.md
# Ablageort, Form s3:https://<Endpunkt>/<Bucket>
RESTIC_REPOSITORY=
# Schlüssel des Servers für das restic-Archiv
RESTIC_PASSWORD=
# Zugangsdaten des S3-Speichers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Nur setzen, wenn der Anbieter eine Region verlangt
AWS_DEFAULT_REGION=

# Medienspeicher nur für Bilder (#335, #428; Dateien zum Herunterladen sind Links auf das SharePoint): ein eigener Bucket, nicht der des Backups, mit eigenem Schlüssel, der nur dort schreiben und lesen darf. Alle fünf setzen oder keinen; ohne sie startet die API ohne Medien (Routen antworten 501). Anbieter und Bucket stehen noch nicht fest
# Adresse des S3-Dienstes mit https, etwa https://s3.example.org
MEDIEN_S3_ENDPOINT=
MEDIEN_S3_REGION=
MEDIEN_S3_BUCKET=
MEDIEN_S3_ZUGANGSSCHLUESSEL=
MEDIEN_S3_GEHEIMSCHLUESSEL=
# Nur «true», wenn der Anbieter den Bucket im Pfad statt im Hostnamen verlangt
MEDIEN_S3_PFADSTIL=

# Website (#705): Die API erzeugt die Seiten, der Edge-Caddy liefert sie aus. Ohne ID und Adresse entsteht keine Website (Log «website_ausgabe», Art «aus»)
# ID der Abteilung, deren Seiten erscheinen (select id, name from abteilung;)
WEBSITE_ABTEILUNG_ID=
# Adresse der Website mit https, ohne Pfad. Sie muss dieselbe sein wie BETTER_AUTH_URL: Die Anmeldung auf der Website geht über diese Herkunft
WEBSITE_BASIS_URL=

# Rechtemodell (docs/rechte-umstellung.md): alt, schatten (Vorgabe) oder neu
RECHTE_MODELL=

# Verantwortliche Stelle, ihre Anschrift und E-Mail-Adresse für /konto-loeschen und /support. Öffentlich; ohne Wert gelten die Vorgaben in apps/api/src/konfiguration.ts. Nur eintragen, wenn sie sich ändern (keine leeren Zeilen: sie gelten als nicht gesetzt)
# VERANTWORTLICHE_STELLE=
# VERANTWORTLICHE_ADRESSE=
# KONTAKT_EMAIL=
# Telefon der Abteilung für Fuss und Kontaktkarte der Website (#549); öffentlich, ohne Wert fehlt es dort
# KONTAKT_TELEFON=

# Cevi-Datenbank (#691): Die Anmeldung füllt freiwillige Angaben (Geburtsdatum, Telefon, Adresse, E-Mail) aus der Cevi-Datenbank vor, nur lesend. Beide setzen oder keines; ohne sie läuft die Anmeldung wie bisher. Das Token steht nur hier, nie im Repo und nie in einem Chat. Anleitung: docs/cevi-db-einrichten.md
# Adresse der Cevi-Datenbank mit https, etwa https://db.example.org (nur die Herkunft, ohne Pfad)
# CEVI_DB_URL=
# Dienstkonto-Token der Abteilung mit dem einzigen Recht «Personen dieser Ebene»
# CEVI_DB_TOKEN=
# Fotos aus Flickr (#690): Schlüssel und Secret der App bei Flickr, dazu das Token des Kontos (nur Lesen; apps/api/scripts/flickr-token.mjs holt es). Das sind Geheimnisse: nie ins Repository, nie in Chats oder Screenshots. Ohne Schlüssel gibt es keine Fotos; ohne Token sieht der Server nur öffentliche Fotos. Anleitung: docs/flickr-einrichten.md
# FLICKR_API_KEY=
# FLICKR_API_SECRET=
# FLICKR_OAUTH_TOKEN=
# FLICKR_OAUTH_TOKEN_SECRET=
# Kennung des Flickr-Kontos, dem das Token gehört (das Skript nennt sie), zum Beispiel 12345678@N00. Pflicht mit Token: Nur für dieses Konto signiert der Server, jedes andere sieht nur Öffentliches (#777)
# FLICKR_KONTO=

# Outlook-Kalender schreiben (#835, docs/betrieb.md «Outlook schreiben»): Cevi OS führt die Kategorienliste des Postfachs und die Kategorien einzelner Termine in Outlook nach (Microsoft Graph, delegierte Anmeldung) und liest die Kategorien der Termine von dort. Mandant und Client-ID der App-Registrierung sind Geheimnisse: nie ins Repository, nie in Chats oder Screenshots. Das Token liegt verschlüsselt in der Datenbank (npm run kalender:outlook-verbinden). Ohne OUTLOOK_GRAPH=true bleibt alles beim Lesen über die iCal-Adresse
# OUTLOOK_GRAPH=false
# OUTLOOK_TENANT_ID=
# OUTLOOK_CLIENT_ID=

# App-Nachweis (#785, docs/betrieb.md, docs/app-nachweis.md): Der Server erkennt die App am Nachweis des Betriebssystems (Google Play Integrity, Apple App Attest) statt am Header Origin. Bleibt `aus`, bis beide Apps den Nachweis senden; dann `pruefen` (nur im Log melden), später `pflicht`. Ausser bei `aus` sind beide Plattformen Pflicht. Die Schlüsseldatei des Google-Dienstkontos gehört nach deploy/secrets/play-integrity-service-account.json, nie hierher, nie ins Repository
# APP_NACHWEIS=aus
# Android: Paketname der App und SHA-256-Fingerabdruck des Zertifikats der App-Signatur (Play Console), mehrere durch Komma getrennt
# ANDROID_PAKETNAME=
# ANDROID_ZERTIFIKAT_SHA256=
# Freiwillig: MEETS_BASIC_INTEGRITY, MEETS_DEVICE_INTEGRITY (Vorgabe) oder MEETS_STRONG_INTEGRITY
# ANDROID_NACHWEIS_MIN_GERAETE=
# iOS: Team-ID, Bundle-ID und Umgebung des Schlüssels (production oder development)
# IOS_TEAM_ID=
# IOS_BUNDLE_ID=
# IOS_NACHWEIS_UMGEBUNG=production

# Nicht hier einzutragen: Wetter (Open-Meteo, fester Host im Code), PDF-Aushänge, Suche und das Lager brauchen keine Umgebungsvariablen. Die Website (WEBSITE_AUSGABE_PFAD, WEBSITE_ABTEILUNG_ID, WEBSITE_BASIS_URL) wird erst eingetragen, wenn der Ort der erzeugten Dateien feststeht: docs/website-auslieferung.md
