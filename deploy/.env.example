# Vorlage für deploy/.env auf dem Server, Rechte 600; docker-compose.prod.yml liest die Werte
# Passwörter nur hexadezimal, etwa aus openssl rand -hex 32: Sie stehen in Datenbank-URLs

# Superuser von PostgreSQL; gilt nur beim Einrichten eines leeren Volumes
POSTGRES_PASSWORD=
# Die Passwörter der beiden Rollen setzt deploy.sh bei jedem Deploy; ein neuer Wert wechselt sie
# Rolle der API (cevi_os_api)
API_DB_PASSWORD=
# Besitzer der Tabellen (cevi_os_besitzer), nur für die Migration
MIGRATION_DB_PASSWORD=
# Älteste App-Version, die die API annimmt (x.y.z); ältere bekommen 426
APP_MIN_VERSION=
# Schlüssel von better-auth, mindestens 32 Zeichen, etwa aus openssl rand -base64 32; ein Wechsel macht die zweiten Faktoren unlesbar (docs/betrieb.md)
BETTER_AUTH_SECRET=
# Öffentliche Adresse der API mit https, etwa https://api.cevios.ch
BETTER_AUTH_URL=

# Verschlüsselte Backups mit restic (backup.sh); Einrichtung: docs/betrieb.md
# Ablageort, Form s3:https://<Endpunkt>/<Bucket>
RESTIC_REPOSITORY=
# Schlüssel des Servers für das restic-Archiv
RESTIC_PASSWORD=
# Zugangsdaten des S3-Speichers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Nur setzen, wenn der Anbieter eine Region verlangt
AWS_DEFAULT_REGION=
