# Vorlage für apps/api/.env, nur für die Entwicklung; npm run dev -w apps/api und npm run db:migrieren -w apps/api lesen die Datei
# PostgreSQL aus docker-compose.yml, ohne Passwort
# Rolle der API: liest und schreibt Daten, ändert aber nichts am Schema
DATABASE_URL=postgres://cevi_os_api@localhost:5432/cevi_os
# Besitzer der Tabellen, nur für die Migrationen
MIGRATION_DATABASE_URL=postgres://cevi_os_besitzer@localhost:5432/cevi_os
# Älteste App-Version, die die API annimmt; ältere bekommen 426
APP_MIN_VERSION=0.1.0
PORT=3000
# Geheimnis von better-auth für Sitzungen und die TOTP-Verschlüsselung, mindestens 32 Zeichen; Erzeugung steht im README
BETTER_AUTH_SECRET=
# Basis-URL der API; mit https setzt better-auth Secure-Cookies
BETTER_AUTH_URL=http://localhost:3000
# Zugriffstoken für den Push-Versand über Expo; das echte liegt nur in der .env des Servers, nie im Repo
# Expo lehnt den Platzhalter ab, sobald «Enhanced Security for Push Notifications» eingeschaltet ist
EXPO_ACCESS_TOKEN=platzhalter-entwicklung
# Freiwillig: Pfad zur JSON-Schlüsseldatei des Google-Service-Accounts; die Datei bleibt ausserhalb des Repos
# GOOGLE_APPLICATION_CREDENTIALS=
# Nur für npm run kalender:aufzeichnen: die ID des Testkalenders «Cevi OS Test», nie die des echten Kalenders
# TESTKALENDER_ID=
