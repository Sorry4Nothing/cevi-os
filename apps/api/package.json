    "firebase-admin": "^14.5.1",
    "hono": "4.13.19",
    "ical.js": "^2.2.1",
    "pdfkit": "0.21.0",
    "postgres": "^4.1.1",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
