{
  "expo": {
    "name": "Cevi OS",
    "slug": "cevi-os",
    "scheme": "cevi-os",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "CFBundleDevelopmentRegion": "de"
      }
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cevi OS nutzt Face ID, um die App zu entsperren."
        }
      ]
    ]
  }
}
